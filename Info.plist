<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- plain http to any address the user enters: self-hosted servers often run http under a home name
	     (nas.lan, a Tailscale name), which NSAllowsLocalNetworking alone would block -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- Sparkle updates: the feed scripts/release.sh attaches to every GitHub Release, and the public half of the signing key
	     (the private half is in the release machine's keychain, account "immich-viewer") -->
	<key>SUFeedURL</key>
	<string>https://github.com/johnlin10/immich-viewer/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>fAp20C77IDuVr3IqKWAyICo1UsjjH73/gqASO7ArtiI=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- shown in the Local Network permission prompt (translated in InfoPlist.xcstrings) -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Immich Viewer connects to your Immich server on the local network.</string>
	<!-- iOS: Save Image and Save Video in the share sheet, for photos shared from the server -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Immich Viewer saves the photos and videos you share from your Immich server to your photo library.</string>
	<!-- iOS: Upload from Photos, to upload each photo as the library has it (its date, name, a Live Photo's video) -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Immich Viewer uploads the photos and videos you pick to your Immich server, with their dates and Live Photo videos.</string>
</dict>
</plist>

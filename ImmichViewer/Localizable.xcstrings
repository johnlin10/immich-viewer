    "Commands run in zsh, as in Terminal. For a server on another computer, run them over SSH with key login, for example: ssh nas 'cd immich-app && docker compose up -d'": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指令在 zsh 中執行，和在「終端機」裡一樣。伺服器在其他電腦上時，可透過 SSH（使用金鑰登入）執行，例如：ssh nas 'cd immich-app && docker compose up -d'"
          }
        }
      }
    },
    "Connect": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線"
          }
        }
      }
    },
    "Connected": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連線"
          }
        }

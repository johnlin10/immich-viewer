    },
    "Thumbnails are kept on this Mac, so scrolling doesn’t wait on the server. After clearing, photos download again when they are shown; Refresh (⌘R) gets them all back at once.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",

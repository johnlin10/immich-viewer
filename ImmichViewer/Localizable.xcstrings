    "%@\nThe key needs the person.read and album.read permissions.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n金鑰需要 person.read 和 album.read 權限。"
          }
        }
      }
    },

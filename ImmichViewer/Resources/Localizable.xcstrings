    "Couldn’t reach %@: %@ Check the address and port, and that the server is running. For a server on another computer, also check that Immich Viewer is on in System Settings > Privacy & Security > Local Network." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn’t reach %1$@: %2$@ Check the address and port, and that the server is running. For a server on another computer, also check that Immich Viewer is on in System Settings > Privacy & Security > Local Network."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線到 %1$@：%2$@ 請檢查位址和連接埠，以及伺服器是否正在執行。如果伺服器在其他電腦上，也請到「系統設定」>「隱私權與安全性」>「區域網路」確認 Immich Viewer 已開啟。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接到 %1$@：%2$@ 请检查地址和端口，以及服务器是否正在运行。如果服务器在其他电脑上，还请前往“系统设置”>“隐私与安全性”>“本地网络”，确认 Immich Viewer 已开启。"
          }
        }
      }

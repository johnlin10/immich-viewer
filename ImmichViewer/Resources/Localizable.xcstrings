    "The person you choose becomes %@: their photos move over and they are gone. This can’t be undone." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你選的人物會併入「%@」：他們的照片會移過來，原本的人物會消失。此動作無法還原。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你选择的人物将合并到“%@”：其照片会移过来，原来的人物将消失。此操作无法撤销。"
          }
        }
      }
    },
    "The photos in it stay in your library." : {
      "localizations" : {

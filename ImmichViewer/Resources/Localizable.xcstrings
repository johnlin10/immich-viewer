      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指令在 zsh 中執行，和在「終端機」裡一樣。伺服器在其他電腦上時，可透過 SSH（使用金鑰登入）執行，例如：ssh nas 'cd immich-app && docker compose up -d'"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
